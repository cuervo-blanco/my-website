{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "dist",
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/film",
        "destination": "/#credits",
        "type": 301
      },
      {
        "source": "/film/samples",
        "destination": "/#portfolio-films",
        "type": 301
      },
      {
        "source": "/samples",
        "destination": "/#portfolio-films",
        "type": 301
      },
      {
        "source": "/portfolio",
        "destination": "/#portfolio-films",
        "type": 301
      },
      {
        "source": "/live",
        "destination": "/#live-credits",
        "type": 301
      },
      {
        "source": "/live/companies",
        "destination": "/#recent-clients",
        "type": 301
      },
      {
        "source": "/companies",
        "destination": "/#recent-clients",
        "type": 301
      },
      {
        "source": "/software",
        "destination": "/dev",
        "type": 301
      },
      {
        "source": "/projects",
        "destination": "/dev",
        "type": 301
      },
      {
        "source": "/dev/projects",
        "destination": "/dev",
        "type": 301
      },
      {
        "source": "/dsp-dictionary",
        "destination": "/dev",
        "type": 301
      },
      {
        "source": "/art/about",
        "destination": "/art",
        "type": 301
      },
      {
        "source": "/about",
        "destination": "/art",
        "type": 301
      },
      {
        "source": "/dev/dsp-dictionary",
        "destination": "/dev",
        "type": 301
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "audio/**",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/firmware/firmware.bin",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/octet-stream"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"firmware.bin\""
          }
        ]
      },
      {
        "source": "/CV/JaimeORiveraCV-2025v09.pdf",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/pdf"
          },
          {
            "key": "Content-Disposition",
            "value": "inline; filename=\"JaimeORiveraCV-2025v09.pdf\""
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/licensing",
        "function": "licensing"
      },
      {
        "source": "/api/licensing/**",
        "function": "licensing"
      },
      {
        "source": "/CV/JaimeORiveraCV-2025v09.pdf",
        "destination": "/CV/JaimeORiveraCV-2025v09.pdf"
      },
      {
        "source": "/firmware/firmware.bin",
        "destination": "/firmware/firmware.bin"
      },
      {
        "source": "/terms",
        "destination": "/terms/index.html"
      },
      {
        "source": "/dev",
        "destination": "/dev/index.html"
      },
      {
        "source": "/art",
        "destination": "/art/index.html"
      },
      {
        "source": "/contact",
        "destination": "/contact/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
